### ============================================
### CAMBIAR EL PUERTO SI ES NECESARIO (5245)
### ============================================
@baseUrl = http://localhost:5245/api

### ============================================
### 1. REGISTRAR Usuarios de prueba
### ============================================
POST {{baseUrl}}/Auth/register
Content-Type: application/json

{
    "email": "jorge@test.com",
    "password": "password123",
    "nombreCompleto": "Jorge Prueba",
    "nombreUsuario": "jorge123"
}

### ============================================
### 2. LOGIN con usuario registrado
### ============================================
POST {{baseUrl}}/Auth/login
Content-Type: application/json

{
    "email": "jorge@gmail.com",
    "password": "jorgeee"
}

### ============================================
### 3. Obtener Mis Eventos
### Asegúrate de cambiar el userId por el que te devuelva el login
### ============================================
GET {{baseUrl}}/Eventos/mis-eventos?userId=16


### ============================================
### 4. Probar conexión con Supabase (Test)
### ============================================
GET {{baseUrl}}/test-connection

### ============================================
### 5. ERRORES ESPERADOS (Pruebas Negativas)
### ============================================

# Login con credenciales incorrectas
POST {{baseUrl}}/Auth/login
Content-Type: application/json

{
    "email": "noexiste@test.com",
    "password": "wrongpassword"
}

# Registro sin email (debe fallar la validación)
POST {{baseUrl}}/Auth/register
Content-Type: application/json

{
    "email": "",
    "password": "123456",
    "nombreCompleto": "Test"
}
