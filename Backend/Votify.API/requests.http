### ============================================
### CAMBIAR EL PUERTO SI ES NECESARIO (5245)
### ============================================
@baseUrl = http://localhost:5245/api

### ============================================
### 1. REGISTRAR Usuarios de prueba
### ============================================
POST {{baseUrl}}/Auth/register
Content-Type: application/json

{
    "email": "jorge@test.com",
    "password": "password123",
    "nombreCompleto": "Jorge Prueba",
    "nombreUsuario": "jorge123"
}

### ============================================
### 2. LOGIN con usuario registrado
### ============================================
POST {{baseUrl}}/Auth/login
Content-Type: application/json

{
    "email": "jorge@gmail.com",
    "password": "jorgeee"
}

### ============================================
### 3. Obtener Mis Eventos
### Asegúrate de cambiar el userId por el que te devuelva el login
### ============================================
GET {{baseUrl}}/Eventos/mis-eventos?userId=16


### ============================================
### 4. Probar conexión con Supabase (Test)
### ============================================
GET {{baseUrl}}/test-connection

### ============================================
### 5. ERRORES ESPERADOS (Pruebas Negativas)
### ============================================

# Login con credenciales incorrectas
POST {{baseUrl}}/Auth/login
Content-Type: application/json

{
    "email": "noexiste@test.com",
    "password": "wrongpassword"
}

# Registro sin email (debe fallar la validación)
POST {{baseUrl}}/Auth/register
Content-Type: application/json

{
    "email": "",
    "password": "123456",
    "nombreCompleto": "Test"
}

### ============================================
### 8. CREAR un Evento Válido (Hackathon)
### ============================================
POST {{baseUrl}}/Event
Content-Type: application/json

{
  "nombre": "Hackathon Innovación 2026",
  "descripcion": "48 horas de puro código para crear soluciones del futuro.",
  "fechaIni": "2026-05-10T10:00:00",
  "fechaFin": "2026-05-12T10:00:00",
  "tipoEvento": "Hackaton",
  "idOrganizador": 1,
  "categorias": [
    {
      "nombre": "Mejor Arquitectura Backend",
      "pesos": [
        {
          "rolVotante": "Jurado",
          "peso": 70
        },
        {
          "rolVotante": "Publico",
          "peso": 30
        }
      ]
    }
  ],
  "baremos": [
    {
      "nombre": "Evaluación Técnica",
      "criterios": [
        {
          "nombre": "Calidad del Código",
          "peso": 50,
          "tipoCriterio": "Numerico"
        },
        {
          "nombre": "Originalidad",
          "peso": 50,
          "tipoCriterio": "Numerico"
        }
      ]
    }
  ]
}

### ============================================
### 9. CREAR un Evento INVÁLIDO (Debería dar error 400)
### ============================================
POST {{baseUrl}}/Event
Content-Type: application/json

{
  "nombre": "Ev", 
  "descripcion": "Este evento va a fallar por todos lados",
  "fechaIni": "2026-10-10T10:00:00",
  "fechaFin": "2026-10-08T10:00:00", 
  "tipoEvento": "Fiesta", 
  "idOrganizador": 1,
  "categorias": [],
  "baremos": []
}